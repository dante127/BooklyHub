# Copy to .env and replace every value before running docker compose.
# Generate a signing key: openssl rand -base64 48
MSSQL_SA_PASSWORD=change-me-strong-sa-password
JWT_SECRET=change-me-to-a-unique-random-value-of-at-least-32-bytes

# Only used when the database is empty; the seeder creates this platform administrator.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password

# What this deployment does with money and messages. Production refuses 'Simulated': its payment provider
# answers every positive charge as Paid with a synthetic txn_sim_* id, and its senders log a line and report
# success. 'None' (the default here) charges nothing and sends nothing, and says so in the refusal, so a
# clinic taking payment on arrival can run this build until a real gateway and sender are registered.
PAYMENTS_PROVIDER=None
NOTIFICATIONS_PROVIDER=None
