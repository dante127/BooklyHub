# Copy to .env and replace every value before running docker compose.
# Generate a signing key: openssl rand -base64 48
MSSQL_SA_PASSWORD=change-me-strong-sa-password
JWT_SECRET=change-me-to-a-unique-random-value-of-at-least-32-bytes

# Only used when the database is empty; the seeder creates this platform administrator.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password

# The scripted demo half of the seeder: three clinics with their staff, invented patients and appointments.
# Off by default, because there is no tenant delete route and a production tenant table that arrives pre-filled
# is somebody's data. Turn it on for a review or development database, and know that it is read on the first
# seeding run only — flipping it later is a no-op on a database that already has its reference rows.
SEED_DEMO_TENANTS=false

# What this deployment does with money and messages. Production refuses 'Simulated': its payment provider
# answers every positive charge as Paid with a synthetic txn_sim_* id, and its senders log a line and report
# success. 'None' (the default here) charges nothing and sends nothing, and says what it refused, so a clinic
# taking payment on arrival can run this build until a real gateway and sender are registered.
PAYMENTS_PROVIDER=None
NOTIFICATIONS_PROVIDER=None

# The Host values this site answers on, ';' or ',' separated. '*' (the default) admits every host and installs
# no filter at all. Name the real names in production: an empty list is not what a public API should answer to.
ALLOWED_HOSTS=*

# The port a plain request is redirected to. Leave empty when TLS ends in front of this container (a proxy that
# redirects on its own), which is also the state the image was built in. Setting it installs the redirect.
HTTPS_REDIRECT_PORT=

# The address of the proxy that writes X-Forwarded-For, if there is one; comma-separated for several. Empty
# means no header is read, so every caller behind one proxy shares a rate-limit bucket. A host name is refused
# at startup; give the address the connections actually arrive from.
FORWARDING_KNOWN_PROXIES=
